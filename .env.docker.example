# Copy to .env.docker. Values are passed literally; do not wrap them in quotes.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=photos
SESSION_SECRET=

# Production admin access: put only your own user object ID in the allowlist.
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ALLOWED_OBJECT_IDS=
ENTRA_REDIRECT_URI=https://YOUR_INTERNAL_HOST/auth/callback

# Replace after your server team confirms the HTTPS proxy configuration.
TRUST_PROXY=false

# Only needed for compose.local.yaml HTTP testing; use a temporary test password.
ADMIN_PASSWORD=
